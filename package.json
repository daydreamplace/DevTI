{
  "name": "devti",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "serve out --listen 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:export",
    "verify:export": "node scripts/verify-export.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "compression": "^1.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
